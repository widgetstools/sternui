{
  "name": "marketsui-platform",
  "version": "0.1.0",
  "private": true,
  "description": "MarketsUI platform — modular Markets UI monorepo.",
  "packageManager": "npm@10.9.0",
  "workspaces": [
    "packages/design-system/*",
    "packages/angular-ui/*",
    "packages/react-ui/*",
    "packages/angular-grid/*",
    "packages/react-grid/*",
    "packages/data/*",
    "packages/openfin/*",
    "packages/angular-core/*",
    "packages/react-core/*",
    "packages/shared/*",
    "apps/*",
    "apps/e2e/*",
    "apps/legacy/*",
    "apps/tutorials-tarball/*",
    "apps/tutorials-workspace/*",
    "tools/mcp-scaffold",
    "e2e-openfin"
  ],
  "scripts": {
    "build:packages": "turbo build --filter=!./apps/** --concurrency=50%",
    "build:apps": "turbo build --filter=./apps/** --concurrency=50%",
    "build:consumer": "npm run build:packages && node scripts/propagate.mjs --no-build && npm run build:apps",
    "build": "npm run build:consumer",
    "typecheck:packages": "turbo typecheck --filter=!./apps/**",
    "typecheck:apps": "turbo typecheck --filter=./apps/**",
    "typecheck:consumer": "npm run build:packages && node scripts/propagate.mjs --skip-drift-check --no-build && npm run typecheck:apps",
    "typecheck": "npm run typecheck:consumer",
    "test:packages": "turbo test --filter=!./apps/**",
    "test": "npm run test:packages",
    "check:tarballs": "npm run build:packages && node scripts/propagate.mjs --check-only --no-install --no-build",
    "verify:consumer": "npm run build:consumer && npm run typecheck:apps",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:ui": "playwright test --ui",
    "dev": "npm run dev:demo-react",
    "dev:demo-react": "npm run dev --workspace=@starui/demo-react",
    "dev:demo-configservice-react": "npm run dev --workspace=@starui/demo-configservice-react",
    "dev:demo-angular": "npm run start --workspace=@starui/demo-angular",
    "dev:tutorial-basic": "npm run dev --workspace=@starui/tutorial-basic",
    "dev:tutorial-mockdata-provider": "npm run dev --workspace=@starui/tutorial-mockdata-provider",
    "dev:tutorial-dataprovider-editor": "npm run dev --workspace=@starui/tutorial-dataprovider-editor",
    "dev:tutorial-stomp": "npm run dev --workspace=@starui/tutorial-stomp",
    "dev:tutorial-basic-workspace": "npm run dev --workspace=@starui/tutorial-basic-workspace",
    "dev:tutorial-mockdata-provider-workspace": "npm run dev --workspace=@starui/tutorial-mockdata-provider-workspace",
    "dev:tutorial-dataprovider-editor-workspace": "npm run dev --workspace=@starui/tutorial-dataprovider-editor-workspace",
    "dev:tutorial-stomp-workspace": "npm run dev --workspace=@starui/tutorial-stomp-workspace",
    "dev:browser-blotter": "npm run dev --workspace=@starui/e2e-browser-blotter",
    "dev:openfin-workspace": "npm run dev --workspace=@starui/e2e-openfin-workspace",
    "dev:openfin:openfin-workspace": "concurrently -k -n vite,openfin -c cyan,magenta \"npm run dev:openfin-workspace\" \"wait-on http://localhost:5181 && node tools/scripts/launch-openfin.mjs http://localhost:5181/platform/manifest.fin.json\"",
    "dev:markets-ui-react-reference": "npm run dev --workspace=@starui/markets-ui-react-reference",
    "dev:markets-grid-lab": "npm run dev --workspace=@starui/markets-grid-lab",
    "dev:demo-stomp-markets-grid": "npm run dev --workspace=@starui/demo-stomp-markets-grid",
    "dev:stomp-marketsgrid-minimal": "npm run dev --workspace=@starui/stomp-marketsgrid-minimal",
    "dev:platform-hooks-demo": "npm run dev --workspace=@starui/platform-hooks-demo",
    "dev:stomp": "npm run dev --workspace=@starui/stomp-view-server",
    "dev:demo": "npm run dev:demo-react",
    "dev:openfin": "concurrently -k -n vite,openfin -c cyan,magenta \"npm run dev:demo-react -- --no-open\" \"wait-on http://localhost:5190 && node tools/scripts/launch-openfin.mjs http://localhost:5190/openfin/manifest.json\"",
    "dev:openfin:markets-react": "concurrently -k -n vite,openfin -c cyan,magenta \"npm run dev:markets-ui-react-reference -- --no-open\" \"wait-on http://localhost:5174 && node tools/scripts/launch-openfin.mjs http://localhost:5174/platform/manifest.fin.json\"",
    "dev:openfin:demo-stomp-markets-grid": "concurrently -k -n vite,openfin -c cyan,magenta \"npm run dev:demo-stomp-markets-grid -- --no-open\" \"wait-on http://localhost:5210 && node apps/demo-stomp-markets-grid/launch.mjs\"",
    "launch:openfin": "node tools/scripts/launch-openfin.mjs",
    "e2e:openfin": "npm run test:e2e -w @starui/e2e-openfin",
    "test:e2e:openfin": "npm run test:e2e -w @starui/e2e-openfin",
    "test:e2e:openfin:vitest-legacy": "npm run test:e2e -w @starui/e2e-openfin-vitest",
    "propagate": "node scripts/propagate.mjs",
    "pack:mcp": "node scripts/pack-mcp-scaffold.mjs",
    "sync:app-deps": "node scripts/sync-app-tarball-deps.mjs",
    "verify:apps": "node scripts/verify-apps.mjs",
    "docs:marketsgrid-usage-pdf": "node scripts/generate-marketsgrid-usage-guide-pdf.mjs",
    "check:deps": "node scripts/check-package-cycles.mjs",
    "check:deps:strict": "node scripts/check-package-cycles.mjs --strict",
    "clean": "rimraf -g node_modules packages/*/*/node_modules packages/*/*/dist apps/*/node_modules apps/e2e/*/node_modules apps/tutorials-tarball/*/node_modules apps/tutorials-workspace/*/node_modules apps/legacy/*/node_modules .turbo"
  },
  "devDependencies": {
    "@openfin/node-adapter": "43.101.2",
    "@playwright/test": "^1.59.1",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.3",
    "postcss": "^8.5.9",
    "rimraf": "^6.0.1",
    "tailwindcss": "3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "turbo": "^2.9.16",
    "typescript": "~5.9.3",
    "vitest": "^4.1.4",
    "wait-on": "^8.0.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-darwin-arm64": "4.60.4",
    "@rollup/rollup-darwin-x64": "4.60.4",
    "@rollup/rollup-linux-arm64-gnu": "4.60.4",
    "@rollup/rollup-linux-x64-gnu": "4.60.4",
    "@rollup/rollup-win32-arm64-msvc": "4.60.4",
    "@rollup/rollup-win32-x64-msvc": "4.60.4"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "@openfin/core": "43.101.2",
    "esbuild": "0.28.0",
    "hono": "^4.12.20"
  }
}
