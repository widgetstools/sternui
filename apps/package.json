{
  "name": "starui-apps",
  "version": "0.0.0",
  "private": true,
  "description": "Nested workspace for StarUI consumer apps (tarball + workspace dev tracks).",
  "workspaces": [
    "consumer-tarball/*",
    "consumer-workspace/*",
    "demo-stomp-markets-grid",
    "e2e/*",
    "legacy/*",
    "platform-hooks-demo",
    "stomp-view-server",
    "tutorials-tarball/*",
    "tutorials-workspace/*"
  ],
  "scripts": {
    "ci": "npm ci",
    "build": "cd .. && npx turbo run build --filter=./apps/**",
    "typecheck": "cd .. && npx turbo run typecheck --filter=./apps/**"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "@openfin/core": "43.101.2",
    "esbuild": "0.28.0",
    "hono": "^4.12.20"
  },
  "dependencies": {
    "marketsui-platform": "file:.."
  }
}
