{
  "name": "starui-apps",
  "version": "0.0.0",
  "private": true,
  "description": "Nested workspace for StarUI consumer/reference demo apps. Each app runs in two modes: installed (file:libs/*.tgz tarballs, consumer parity) or source (STARUI_DEV_SOURCE=1 → Vite aliases @starui/* to packages/ source).",
  "workspaces": [
    "demos/*"
  ],
  "scripts": {
    "install:apps": "npm install",
    "build": "node ../scripts/build-app-track.mjs installed build",
    "build:source": "node ../scripts/build-app-track.mjs source build",
    "typecheck": "node ../scripts/build-app-track.mjs installed typecheck",
    "typecheck:source": "node ../scripts/build-app-track.mjs source typecheck"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "@openfin/core": "43.101.2",
    "esbuild": "0.28.0",
    "hono": "^4.12.20"
  },
  "dependencies": {
    "marketsui-platform": "file:.."
  }
}
