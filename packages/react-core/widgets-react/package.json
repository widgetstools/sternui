{
  "name": "@starui/widgets-react",
  "version": "1.0.0",
  "description": "MarketsUI React widgets — HostedMarketsGrid and trading primitives",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./markets-grid-container": {
      "types": "./dist/container/markets-grid-container/index.d.ts",
      "import": "./dist/container/markets-grid-container/index.js"
    },
    "./provider-editor": {
      "types": "./dist/container/provider-editor/index.d.ts",
      "import": "./dist/container/provider-editor/index.js"
    },
    "./data-provider-selector": {
      "types": "./dist/container/data-provider-selector/index.d.ts",
      "import": "./dist/container/data-provider-selector/index.js"
    },
    "./hosted": {
      "types": "./dist/hosted/index.d.ts",
      "import": "./dist/hosted/index.js"
    }
  },
  "scripts": {
    "build": "rimraf dist tsconfig.tsbuildinfo && tsc",
    "watch": "tsc --watch",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "soak:value-getter": "npx cross-env SOAK=1 NODE_OPTIONS=--expose-gc vitest run src/container/markets-grid-container/valueGetter.soak.test.ts --no-file-parallelism"
  },
  "peerDependencies": {
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "ag-grid-community": "^35.1.0",
    "ag-grid-react": "^35.1.0",
    "ag-grid-enterprise": "^35.1.0",
    "@tanstack/react-query": "^5.80.0",
    "lucide-react": "^0.554.0",
    "@openfin/workspace": "23.0.20",
    "@openfin/workspace-platform": "23.0.20",
    "@starui/grid": "*"
  },
  "dependencies": {
    "@starui/grid": "*",
    "@starui/host-config": "*",
    "@starui/host-data": "*",
    "@starui/design-system": "*",
    "@starui/engine": "*",
    "@starui/host-data-react": "*",
    "@starui/perspective-engine": "*",
    "@starui/host-openfin": "*",
    "@starui/shared-types": "*",
    "@starui/types": "*",
    "@starui/widget-sdk": "*",
    "@starui/ui": "*",
    "@starui/config-browser": "*",
    "@stomp/stompjs": "^7.3.0"
  },
  "devDependencies": {
    "@openfin/workspace": "23.0.20",
    "@openfin/workspace-platform": "23.0.20",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "ag-grid-community": "35.1.0",
    "ag-grid-enterprise": "35.1.0",
    "ag-grid-react": "35.1.0",
    "rimraf": "^6.0.1",
    "typescript": "~5.9.3",
    "vitest": "^4.1.4",
    "jsdom": "^29.0.2",
    "@testing-library/react": "^16.3.2",
    "@testing-library/dom": "^10.4.0",
    "react": "~19.2.5",
    "react-dom": "~19.2.5"
  },
  "keywords": [
    "star",
    "widgets",
    "blotter",
    "ag-grid",
    "trading"
  ],
  "author": "Star Development Team",
  "license": "MIT"
}
