    --bn-t3:        #565d68;
    --bn-t4:        #565d68;
    --bn-border:    #414a56;
    --bn-border2:   #545d6f;
    --bn-border3:   #545d6f;
    --bn-green:     #22e3a8;
    --bn-green2:    #3fecb8;
    --bn-red:       #ff5a82;
    --bn-red2:      #ff7898;
    --bn-amber:     #f5c14b;
    --bn-blue:      #22d3ee;
    --bn-blue2:     #4ae0f2;
    --bn-info:      #22d3ee;
    --bn-cyan:      #22d3ee;
    --bn-purple:    #a78bfa;
    --bn-buy-bg:    #22e3a8;
    --bn-sell-bg:   #ff5a82;
    --bn-cta-text:  #07251b;
    --ob-bid-fill:  rgba(34,227,168,0.16);
    --ob-ask-fill:  rgba(255,90,130,0.16);
    --tt-bid-strip: rgba(34,227,168,0.12);
    --tt-ask-strip: rgba(255,90,130,0.12);
    
    /* ── STARUI --st-* source tokens ── */
    --st-bg:           #20262e;
    --st-bg-1:         #2a3038;
    --st-bg-2:         #323942;
    --st-bg-3:         #3b434e;
    --st-t0:           #ecf0f5;
    --st-t1:           #aab3bf;
    --st-t2:           #7d8694;
    --st-t3:           #565d68;
    --st-border:       #414a56;
    --st-border-2:     #545d6f;
    --st-divider:      #373f4a;
    --st-accent:       #22d3ee;
    --st-accent-hover: #4ae0f2;
    --st-accent-fg:    #06232b;
    --st-accent-soft:  rgba(34,211,238,0.12);
    --st-accent-ring:  rgba(34,211,238,0.45);
    --st-buy:          #22e3a8;
    --st-buy-hover:    #3fecb8;
    --st-buy-fg:       #07251b;
    --st-buy-soft:     rgba(34,227,168,0.12);
    --st-buy-ring:     rgba(34,227,168,0.40);
    --st-sell:         #ff5a82;
    --st-sell-hover:   #ff7898;
    --st-sell-fg:      #2a0810;
    --st-sell-soft:    rgba(255,90,130,0.12);
    --st-sell-ring:    rgba(255,90,130,0.40);
    --st-warn:         #f5c14b;
    --st-warn-soft:    rgba(245,193,75,0.13);
    --st-warn-ring:    rgba(245,193,75,0.40);
    --st-info:         #22d3ee;
    --st-info-soft:    rgba(34,211,238,0.12);
    --st-info-ring:    rgba(34,211,238,0.45);
    --st-purple:       #a78bfa;
    --st-neutral-soft: rgba(170,179,191,0.10);
    --st-neutral-ring: rgba(170,179,191,0.25);
    --st-hover-overlay:rgba(255,255,255,0.05);
    --st-selection:    rgba(34,211,238,0.22);
    --st-disabled-bg:  #3b434e;
    --st-disabled-fg:  #565d68;
    --st-scrollbar:    #545d6f;
    --st-ob-bid:       rgba(34,227,168,0.16);
    --st-ob-ask:       rgba(255,90,130,0.16);
    --st-shadow-card:    0 1px 0 rgba(255,255,255,0.04) inset, 0 2px 6px rgba(0,0,0,0.5);
    --st-shadow-overlay: 0 1px 0 rgba(255,255,255,0.05) inset, 0 8px 24px rgba(0,0,0,0.55), 0 2px 6px rgba(0,0,0,0.4);
    --st-glow-focus:     0 0 0 2px rgba(34,211,238,0.40), 0 0 24px rgba(34,211,238,0.16);
    --st-font-sans:  'Inter', system-ui, -apple-system, 'Segoe UI', 'Geist', sans-serif;
    --st-font-mono:  'JetBrains Mono', 'IBM Plex Mono', ui-monospace, 'SF Mono', monospace;
    --st-radius:     2px;
    --st-radius-sm:  2px;
    --st-radius-md:  2px;
    --st-radius-lg:  2px;
    --st-t-instant:  80ms cubic-bezier(0.4,0,0.6,1);
    --st-t-fast:     140ms cubic-bezier(0.4,0,0.2,1);
    --st-t-normal:   220ms cubic-bezier(0.4,0,0.2,1);
    --st-t-slow:     420ms cubic-bezier(0.4,0,0.2,1);
    --st-t-tick:     900ms cubic-bezier(0.25,0.1,0.25,1);
    
    /* ── Stockflux --sf-* aliases (SLATE BLUE) ── */
    --sf-bg:        #20262e;
    --sf-bg-1:      #2a3038;
    --sf-bg-2:      #2a3038;
    --sf-bg-3:      #323942;
    --sf-bg-4:      #3b434e;
    --sf-bg-5:      #545d6f;
    --sf-t-0:       #ecf0f5;
    --sf-t-1:       #aab3bf;
    --sf-t-2:       #7d8694;
    --sf-t-3:       #565d68;
    --sf-t-4:       #565d68;
    --sf-border:    #414a56;
