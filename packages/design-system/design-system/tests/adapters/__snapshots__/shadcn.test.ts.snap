    --st-sell-hover:   #9f0f33;
    --st-sell-fg:      #ffffff;
    --st-sell-soft:    rgba(190,18,60,0.09);
    --st-sell-ring:    rgba(190,18,60,0.30);
    --st-warn:         #b45309;
    --st-warn-soft:    rgba(180,83,9,0.10);
    --st-warn-ring:    rgba(180,83,9,0.32);
    --st-info:         #0e7490;
    --st-info-soft:    rgba(14,116,144,0.09);
    --st-info-ring:    rgba(14,116,144,0.30);
    --st-purple:       #6d28d9;
    --st-neutral-soft: rgba(82,74,56,0.07);
    --st-neutral-ring: rgba(82,74,56,0.22);
    --st-hover-overlay:rgba(42,37,25,0.045);
    --st-selection:    rgba(14,116,144,0.16);
    --st-disabled-bg:  #ece6da;
    --st-disabled-fg:  #8a806a;
    --st-scrollbar:    #b4a98f;
    --st-ob-bid:       rgba(15,118,110,0.11);
    --st-ob-ask:       rgba(190,18,60,0.10);
    --st-shadow-card:    0 1px 2px rgba(42,37,25,0.06);
    --st-shadow-overlay: 0 1px 2px rgba(42,37,25,0.08), 0 8px 22px rgba(42,37,25,0.12);
    --st-glow-focus:     0 0 0 3px rgba(14,116,144,0.18);
    --st-font-sans:  'Inter', system-ui, -apple-system, 'Segoe UI', 'Geist', sans-serif;
    --st-font-mono:  'JetBrains Mono', 'IBM Plex Mono', ui-monospace, 'SF Mono', monospace;
    --st-radius:     2px;
    --st-radius-sm:  2px;
    --st-radius-md:  2px;
    --st-radius-lg:  2px;
    --st-t-instant:  80ms cubic-bezier(0.4,0,0.6,1);
    --st-t-fast:     140ms cubic-bezier(0.4,0,0.2,1);
    --st-t-normal:   220ms cubic-bezier(0.4,0,0.2,1);
    --st-t-slow:     420ms cubic-bezier(0.4,0,0.2,1);
    --st-t-tick:     900ms cubic-bezier(0.25,0.1,0.25,1);
    
    /* ── Stockflux --sf-* aliases (SLATE BLUE) ── */
    --sf-bg:        #efede9;
    --sf-bg-1:      #fbf8f2;
    --sf-bg-2:      #fbf8f2;
    --sf-bg-3:      #ece6da;
    --sf-bg-4:      #e0d8c8;
    --sf-bg-5:      #b4a98f;
    --sf-t-0:       #2a2519;
    --sf-t-1:       #524a38;
    --sf-t-2:       #6d6550;
    --sf-t-3:       #8a806a;
    --sf-t-4:       #8a806a;
    --sf-border:    #d3c9b5;
    --sf-border-2:  #b4a98f;
    --sf-border-3:  #b4a98f;
    --sf-teal:      #0e7490;
    --sf-teal-hi:   #155e75;
    --sf-teal-lo:   #155e75;
    --sf-teal-soft: rgba(14,116,144,0.10);
    --sf-teal-ring: rgba(14,116,144,0.32);
    --sf-up:        #0f766e;
    --sf-up-hi:     #0c5e58;
    --sf-up-soft:   rgba(15,118,110,0.10);
    --sf-up-strip:  rgba(15,118,110,0.10);
    --sf-down:      #be123c;
    --sf-down-hi:   #9f0f33;
    --sf-down-soft: rgba(190,18,60,0.09);
    --sf-down-strip:rgba(190,18,60,0.09);
    --sf-flat:      #6d6550;
    --sf-info:      #0e7490;
    --sf-info-soft: rgba(14,116,144,0.09);
    --sf-warn:      #b45309;
    --sf-warn-soft: rgba(180,83,9,0.10);
    --sf-success:   #0f766e;
    --sf-error:     #be123c;
    --sf-bid-fill:  rgba(15,118,110,0.11);
    --sf-ask-fill:  rgba(190,18,60,0.10);
    --sf-scrollbar: #b4a98f;
  }

  [data-theme="dark"][data-cvd="on"] {
    --ds-accent-positive:       #7aa6ff;
    --ds-accent-positive-hover: #7aa6ff;
    --ds-accent-negative:       #ff9d4e;
    --ds-accent-negative-hover: #ff9d4e;
    --ds-action-buy-bg:         #7aa6ff;
    --ds-action-sell-bg:        #ff9d4e;
    --success:                  220 100% 74%;
    --destructive:              27 100% 65%;
  }

  [data-theme="light"][data-cvd="on"] {
    --ds-accent-positive:       #1e4fb8;
    --ds-accent-positive-hover: #1e4fb8;
    --ds-accent-negative:       #c2410c;
    --ds-accent-negative-hover: #c2410c;
    --ds-action-buy-bg:         #1e4fb8;
    --ds-action-sell-bg:        #c2410c;
    --success:                  221 72% 42%;
    --destructive:              17 88% 40%;
  }
}"
`;
