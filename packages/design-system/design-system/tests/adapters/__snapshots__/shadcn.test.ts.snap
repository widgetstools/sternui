    --sf-bid-fill:  rgba(15,118,110,0.13);
    --sf-ask-fill:  rgba(190,31,67,0.11);
    --sf-scrollbar: #b6bbc4;
  }

  [data-theme="dark"][data-cvd="on"] {
    --ds-accent-positive:       #7aa6ff;
    --ds-accent-positive-hover: #7aa6ff;
    --ds-accent-negative:       #ff9d4e;
    --ds-accent-negative-hover: #ff9d4e;
    --ds-action-buy-bg:         #7aa6ff;
    --ds-action-sell-bg:        #ff9d4e;
    --success:                  220 100% 74%;
    --destructive:              27 100% 65%;
  }

  [data-theme="light"][data-cvd="on"] {
    --ds-accent-positive:       #1e4fb8;
    --ds-accent-positive-hover: #1e4fb8;
    --ds-accent-negative:       #c2410c;
    --ds-accent-negative-hover: #c2410c;
    --ds-action-buy-bg:         #1e4fb8;
    --ds-action-sell-bg:        #c2410c;
    --success:                  221 72% 42%;
    --destructive:              17 88% 40%;
  }
  [data-palette="teal"][data-theme="dark"] {
    /* ── FI Design System source tokens ── */
    --ds-primary:           #14b8a6;
    --ds-primary-hover:     #2dd4bf;
    --ds-primary-display:   #2dd4bf;
    --ds-primary-highlight: #5eead4;
    --ds-primary-pressed:   #14b8a6;
    --ds-primary-foreground:#ffffff;
    --ds-primary-soft:      rgba(45,212,191,0.12);
    --ds-primary-ring:      rgba(45,212,191,0.42);

    --ds-surface-ground:     #0d1219;
    --ds-surface-sunken:     #161c25;
    --ds-surface-primary:    #1a212a;
    --ds-surface-secondary:  #2a323d;
    --ds-surface-tertiary:   #363e49;
    --ds-surface-quaternary: #454e5a;

    --ds-text-primary:   #f1f4f6;
    --ds-text-secondary: #cfd5da;
    --ds-text-muted:     #8c969d;
    --ds-text-faint:     #636c74;
    --ds-text-disabled:  #424950;

    --ds-border-primary:   #2d3540;
    --ds-border-secondary: #3f4854;
    --ds-border-tertiary:  #485058;

    --ds-accent-positive:       #2dd4bf;
    --ds-accent-positive-hover: #5eead4;
    --ds-accent-negative:       #f25668;
    --ds-accent-negative-hover: #ff7484;
    --ds-accent-warning:        #f5c14b;
    --ds-accent-info:           #38bdf8;
    --ds-accent-info-hover:     #7dd3fc;
    --ds-accent-highlight:      #00e5ff;
    --ds-accent-purple:         #af7de8;

    --ds-action-buy-bg:    #2dd4bf;
    --ds-action-buy-fg:    #ffffff;
    --ds-action-sell-bg:   #f25668;
    --ds-action-sell-fg:   #ffffff;

    --ds-state-focus-ring:    #14b8a6;
    --ds-state-focus-ring-bg: rgba(45,212,191,0.12);
    --ds-state-disabled-bg:   #363e49;
    --ds-state-disabled-fg:   #424950;
    --ds-state-hover-overlay: rgba(255,255,255,0.05);
    --ds-state-selection:     rgba(45,212,191,0.12);

    --ds-overlay-positive-soft:  rgba(45,212,191,0.13);
    --ds-overlay-positive-ring:  rgba(45,212,191,0.13);
    --ds-overlay-negative-soft:  rgba(242,86,104,0.13);
    --ds-overlay-negative-ring:  rgba(242,86,104,0.13);
    --ds-overlay-warning-soft:   rgba(245,193,75,0.13);
    --ds-overlay-warning-ring:   rgba(245,193,75,0.13);
    --ds-overlay-info-soft:      rgba(56,189,248,0.13);
    --ds-overlay-info-ring:      rgba(56,189,248,0.13);
    --ds-overlay-neutral-soft:   rgba(143,147,154,0.13);
    --ds-overlay-neutral-ring:   rgba(143,147,154,0.24);

    --ds-scrollbar:  #2c4660;

    --ds-elevation-card:    0 1px 2px rgba(0,0,0,0.4);
    --ds-elevation-overlay: 0 4px 12px rgba(0,0,0,0.4), 0 1px 0 rgba(255,255,255,0.04) inset;
    --ds-elevation-glow:    0 0 0 3px rgba(45,212,191,0.42);

    --ds-trade-flat:           #8aa0ad;
    --ds-trade-positive-strip: rgba(45,212,191,0.06);
    --ds-trade-negative-strip: rgba(242,86,104,0.06);
    --ds-trade-bid-fill:       rgba(45,212,191,0.16);
    --ds-trade-ask-fill:       rgba(242,86,104,0.16);

    --ds-chart-1: #14b8a6;
    --ds-chart-2: #2dd4bf;
    --ds-chart-3: #f5c14b;
    --ds-chart-4: #af7de8;
    --ds-chart-5: #f25668;

    /* ── shadcn-compat HSL channel aliases (Stockflux SLATE BLUE) ── */
    --background:             215 18% 7%;
    --foreground:             210 8% 94%;
    --card:                   215 14% 11%;
    --card-foreground:        210 8% 94%;
    --popover:                215 13% 18%;
    --popover-foreground:     210 8% 94%;
    --primary:                173 80% 40%;
    --primary-foreground:     211 47% 8%;
    --secondary:              215 11% 22%;
    --secondary-foreground:   210 8% 94%;
    --muted:                  215 12% 17%;
    --muted-foreground:       210 6% 58%;
    --accent:                 172 66% 50%;
    --accent-foreground:      211 47% 8%;
    --destructive:            354 86% 65%;
    --destructive-foreground: 0 0% 100%;
    --success:                172 66% 50%;
    --success-foreground:     0 0% 100%;
    --warning:                42 89% 63%;
    --warning-foreground:     204 22% 95%;
    --info:                   198 93% 60%;
    --info-foreground:        211 47% 8%;
    --border:                 215 14% 21%;
    --input:                  215 14% 21%;
    --ring:                   172 66% 50%;

    --sidebar-background:              215 22% 6%;
    --sidebar-foreground:              210 8% 94%;
    --sidebar-primary:                 172 66% 50%;
    --sidebar-primary-foreground:      215 18% 7%;
    --sidebar-accent:                  215 13% 16%;
    --sidebar-accent-foreground:       210 8% 94%;
    --sidebar-border:                  215 14% 18%;
    --sidebar-ring:                    172 66% 50%;

    --chart-1: 172 66% 50%;
    --chart-2: 199 89% 60%;
    --chart-3: 268 70% 70%;
    --chart-4: 45 93% 60%;
    --chart-5: 354 86% 65%;

    --surface-50:  214 24% 13%;
    --surface-100: 215 18% 20%;
    --surface-200: 215 15% 25%;
    --surface-300: 214 13% 31%;
    --surface-400: 214 14% 29%;
    --surface-500: 215 17% 21%;
    --surface-600: 208 8% 42%;
    --surface-700: 205 8% 58%;
    --surface-800: 207 13% 83%;
    --surface-900: 204 22% 95%;
    --surface-950: 215 32% 7%;

    /* ── PrimeNG var bridge (for tailwindcss-primeui) ── */
    --p-primary-color:        #14b8a6;
    --p-primary-color-text:   #ffffff;
    --p-surface-50:           #1a212a;
    --p-surface-100:          #2a323d;
    --p-surface-200:          #363e49;
    --p-surface-900:          #f1f4f6;
    --p-surface-950:          #0d1219;
    --p-text-color:           #f1f4f6;
    --p-text-muted-color:     #8c969d;
    --p-content-background:   #1a212a;
    --p-content-border-color: #2d3540;
    --p-content-color:        #f1f4f6;

    /* ── Typography vars ── */
    --ds-font-sans:  'Inter', system-ui, -apple-system, 'Segoe UI', 'Geist', sans-serif;
    --ds-font-mono:  'JetBrains Mono', 'IBM Plex Mono', ui-monospace, 'SF Mono', monospace;
    --ds-font-serif: 'Geist', Georgia, serif;
    --ds-font-size-2xs: 10px;
    --ds-font-size-xs:  11px;
    --ds-font-size-sm:  12px;
    --ds-font-size-md:  13px;
    --ds-font-size-lg:  14px;
    --ds-font-size-xl:  16px;
    --ds-font-size-2xl: 20px;
    --ds-font-size-3xl: 28px;
    --ds-font-size-4xl: 40px;
    --ds-font-size-5xl: 56px;
    --ds-font-variant-tabular: tabular-nums;
    --ds-radius-sm:   3px;
    --ds-radius-md:   3px;
    --ds-radius-lg:   3px;
    --ds-radius-xl:   6px;
    --ds-radius-full: 9999px;
    --radius:         3px;

    /* ── Motion vars (Stockflux tokens.css) ── */
    --ds-tx-instant: 80ms cubic-bezier(0.4,0,0.6,1);
    --ds-tx-fast:    140ms cubic-bezier(0.4,0,0.2,1);
    --ds-tx-normal:  220ms cubic-bezier(0.4,0,0.2,1);
    --ds-tx-slow:    420ms cubic-bezier(0.4,0,0.2,1);
    --ds-tx-tick:    900ms cubic-bezier(0.25,0.1,0.25,1);
    --sf-t-instant:  80ms cubic-bezier(0.4,0,0.6,1);
    --sf-t-fast:     140ms cubic-bezier(0.4,0,0.2,1);
    --sf-t-normal:   220ms cubic-bezier(0.4,0,0.2,1);
    --sf-t-slow:     420ms cubic-bezier(0.4,0,0.2,1);
    --sf-t-tick:     900ms cubic-bezier(0.25,0.1,0.25,1);

    /* ── Control density tiers (compact controls — see tokens/controls.ts) ── */
    --ds-control-xs-height:       24px;
    --ds-control-xs-padding-x:    8px;
    --ds-control-xs-gap:          4px;
    --ds-control-xs-font-size:    12px;
    --ds-control-xs-icon-size:    12px;
    --ds-control-xs-radius:       3px;
    --ds-control-sm-height:       26px;
    --ds-control-sm-padding-x:    10px;
    --ds-control-sm-gap:          6px;
    --ds-control-sm-font-size:    12px;
    --ds-control-sm-icon-size:    14px;
    --ds-control-sm-radius:       3px;
    --ds-control-md-height:       28px;
    --ds-control-md-padding-x:    12px;
    --ds-control-md-gap:          6px;
    --ds-control-md-font-size:    13px;
    --ds-control-md-icon-size:    14px;
    --ds-control-md-radius:       3px;
    --ds-control-lg-height:       30px;
    --ds-control-lg-padding-x:    12px;
    --ds-control-lg-gap:          8px;
    --ds-control-lg-font-size:    13px;
    --ds-control-lg-icon-size:    16px;
    --ds-control-lg-radius:       3px;

    /* ── Legacy bn-* / fi-* aliases (apps + cell renderers) ── */
    --bn-bg:        #0d1219;
    --bn-bg-sunken: #161c25;
    --bn-bg1:       #1a212a;
    --bn-bg2:       #2a323d;
    --bn-bg3:       #363e49;
    --bn-bg4:       #454e5a;
    --bn-t0:        #f1f4f6;
    --bn-t1:        #cfd5da;
    --bn-t2:        #8c969d;
    --bn-t3:        #636c74;
    --bn-t4:        #424950;
    --bn-border:    #2d3540;
    --bn-border2:   #3f4854;
    --bn-border3:   #485058;
    --bn-green:     #2dd4bf;
    --bn-green2:    #5eead4;
    --bn-red:       #f25668;
    --bn-red2:      #ff7484;
    --bn-amber:     #f5c14b;
    --bn-blue:      #14b8a6;
    --bn-blue2:     #2dd4bf;
    --bn-info:      #38bdf8;
    --bn-cyan:      #00e5ff;
    --bn-purple:    #af7de8;
    --bn-buy-bg:    #2dd4bf;
    --bn-sell-bg:   #f25668;
    --bn-cta-text:  #ffffff;
    --ob-bid-fill:  rgba(45,212,191,0.16);
    --ob-ask-fill:  rgba(242,86,104,0.16);
    --tt-bid-strip: rgba(45,212,191,0.06);
    --tt-ask-strip: rgba(242,86,104,0.06);
    
    /* ── Stockflux --sf-* aliases (SLATE BLUE) ── */
    --sf-bg:        #0d1219;
    --sf-bg-1:      #161c25;
    --sf-bg-2:      #1a212a;
    --sf-bg-3:      #2a323d;
    --sf-bg-4:      #363e49;
    --sf-bg-5:      #454e5a;
    --sf-t-0:       #f1f4f6;
    --sf-t-1:       #cfd5da;
    --sf-t-2:       #8c969d;
    --sf-t-3:       #636c74;
    --sf-t-4:       #424950;
    --sf-border:    #2d3540;
    --sf-border-2:  #3f4854;
    --sf-border-3:  #485058;
    --sf-teal:      #2dd4bf;
    --sf-teal-hi:   #5eead4;
    --sf-teal-lo:   #14b8a6;
    --sf-teal-soft: rgba(45,212,191,0.12);
    --sf-teal-ring: rgba(45,212,191,0.42);
    --sf-up:        #2dd4bf;
    --sf-up-hi:     #5eead4;
    --sf-up-soft:   rgba(45,212,191,0.13);
    --sf-up-strip:  rgba(45,212,191,0.06);
    --sf-down:      #f25668;
    --sf-down-hi:   #ff7484;
    --sf-down-soft: rgba(242,86,104,0.13);
    --sf-down-strip:rgba(242,86,104,0.06);
    --sf-flat:      #8aa0ad;
    --sf-info:      #38bdf8;
    --sf-info-soft: rgba(56,189,248,0.13);
    --sf-warn:      #f5c14b;
    --sf-warn-soft: rgba(245,193,75,0.13);
    --sf-success:   #2dd4bf;
    --sf-error:     #f25668;
    --sf-bid-fill:  rgba(45,212,191,0.16);
    --sf-ask-fill:  rgba(242,86,104,0.16);
    --sf-scrollbar: #2c4660;
  }

  [data-palette="teal"][data-theme="light"] {
    /* ── FI Design System source tokens ── */
    --ds-primary:           #0f766e;
    --ds-primary-hover:     #0a5d56;
    --ds-primary-display:   #0f766e;
    --ds-primary-highlight: #0a5d56;
    --ds-primary-pressed:   #115e54;
    --ds-primary-foreground:#ffffff;
    --ds-primary-soft:      rgba(15,118,110,0.10);
    --ds-primary-ring:      rgba(15,118,110,0.32);

    --ds-surface-ground:     #f3f7f9;
    --ds-surface-sunken:     #ffffff;
    --ds-surface-primary:    #ffffff;
    --ds-surface-secondary:  #eef3f6;
    --ds-surface-tertiary:   #e3ecf0;
    --ds-surface-quaternary: #d4e0e7;

    --ds-text-primary:   #06121f;
    --ds-text-secondary: #1c344d;
    --ds-text-muted:     #3e5663;
    --ds-text-faint:     #7d92a0;
    --ds-text-disabled:  #b1bfc8;

    --ds-border-primary:   #c5d1da;
    --ds-border-secondary: #a6b6c2;
    --ds-border-tertiary:  #98aab6;

    --ds-accent-positive:       #0f766e;
    --ds-accent-positive-hover: #0a5d56;
    --ds-accent-negative:       #be1f43;
    --ds-accent-negative-hover: #9e1838;
    --ds-accent-warning:        #b27607;
    --ds-accent-info:           #0e7490;
    --ds-accent-info-hover:     #0c6378;
    --ds-accent-highlight:      #06b6d4;
    --ds-accent-purple:         #7631c4;

    --ds-action-buy-bg:    #0f766e;
    --ds-action-buy-fg:    #ffffff;
    --ds-action-sell-bg:   #be1f43;
    --ds-action-sell-fg:   #ffffff;

    --ds-state-focus-ring:    #0f766e;
    --ds-state-focus-ring-bg: rgba(15,118,110,0.10);
    --ds-state-disabled-bg:   #e3ecf0;
    --ds-state-disabled-fg:   #b1bfc8;
    --ds-state-hover-overlay: rgba(0,0,0,0.045);
    --ds-state-selection:     rgba(15,118,110,0.10);

    --ds-overlay-positive-soft:  rgba(15,118,110,0.10);
    --ds-overlay-positive-ring:  rgba(15,118,110,0.10);
    --ds-overlay-negative-soft:  rgba(190,31,67,0.10);
    --ds-overlay-negative-ring:  rgba(190,31,67,0.10);
    --ds-overlay-warning-soft:   rgba(178,118,7,0.11);
    --ds-overlay-warning-ring:   rgba(178,118,7,0.11);
    --ds-overlay-info-soft:      rgba(14,116,144,0.10);
    --ds-overlay-info-ring:      rgba(14,116,144,0.10);
    --ds-overlay-neutral-soft:   rgba(82,93,108,0.08);
    --ds-overlay-neutral-ring:   rgba(82,93,108,0.14);

    --ds-scrollbar:  #a6b6c2;

    --ds-elevation-card:    0 1px 2px rgba(12,29,48,0.06);
    --ds-elevation-overlay: 0 2px 8px rgba(12,29,48,0.08), 0 1px 0 rgba(255,255,255,0.6) inset;
    --ds-elevation-glow:    0 0 0 3px rgba(15,118,110,0.32);

    --ds-trade-flat:           #3e5663;
    --ds-trade-positive-strip: rgba(15,118,110,0.05);
    --ds-trade-negative-strip: rgba(190,31,67,0.05);
    --ds-trade-bid-fill:       rgba(15,118,110,0.13);
    --ds-trade-ask-fill:       rgba(190,31,67,0.11);

    --ds-chart-1: #0f766e;
    --ds-chart-2: #0f766e;
    --ds-chart-3: #b27607;
    --ds-chart-4: #7631c4;
    --ds-chart-5: #be1f43;

    /* ── shadcn-compat HSL channel aliases (Stockflux SLATE BLUE) ── */
    --background:             200 40% 97%;
    --foreground:             211 60% 7%;
    --card:                   0 0% 100%;
    --card-foreground:        211 60% 7%;
    --popover:                0 0% 100%;
    --popover-foreground:     211 60% 7%;
    --primary:                175 78% 26%;
    --primary-foreground:     0 0% 100%;
    --secondary:              200 28% 92%;
    --secondary-foreground:   211 47% 16%;
    --muted:                  200 28% 92%;
    --muted-foreground:       208 18% 38%;
    --accent:                 175 78% 26%;
    --accent-foreground:      0 0% 100%;
    --destructive:            350 78% 42%;
    --destructive-foreground: 0 0% 100%;
    --success:                175 77% 26%;
    --success-foreground:     0 0% 100%;
    --warning:                39 92% 36%;
    --warning-foreground:     0 0% 100%;
    --info:                   193 82% 31%;
    --info-foreground:        0 0% 100%;
    --border:                 205 24% 78%;
    --input:                  205 24% 78%;
    --ring:                   175 78% 26%;

    --sidebar-background:              200 40% 97%;
    --sidebar-foreground:              211 60% 7%;
    --sidebar-primary:                 175 78% 26%;
    --sidebar-primary-foreground:      0 0% 100%;
    --sidebar-accent:                  200 28% 92%;
    --sidebar-accent-foreground:       211 47% 16%;
    --sidebar-border:                  205 24% 78%;
    --sidebar-ring:                    175 78% 26%;

    --chart-1: 175 78% 26%;
    --chart-2: 199 89% 38%;
    --chart-3: 268 60% 48%;
    --chart-4: 35 85% 42%;
    --chart-5: 350 78% 42%;

    --surface-50:  0 0% 100%;
    --surface-100: 203 31% 95%;
    --surface-200: 198 30% 92%;
    --surface-300: 202 28% 87%;
    --surface-400: 206 19% 71%;
    --surface-500: 206 22% 81%;
    --surface-600: 204 16% 56%;
    --surface-700: 201 23% 32%;
    --surface-800: 211 47% 21%;
    --surface-900: 211 68% 7%;
    --surface-950: 200 33% 96%;

    /* ── PrimeNG var bridge (for tailwindcss-primeui) ── */
    --p-primary-color:        #0f766e;
    --p-primary-color-text:   #ffffff;
    --p-surface-50:           #ffffff;
    --p-surface-100:          #eef3f6;
    --p-surface-200:          #e3ecf0;
    --p-surface-900:          #06121f;
    --p-surface-950:          #f3f7f9;
    --p-text-color:           #06121f;
    --p-text-muted-color:     #3e5663;
    --p-content-background:   #ffffff;
    --p-content-border-color: #c5d1da;
    --p-content-color:        #06121f;

    /* ── Typography vars ── */
    --ds-font-sans:  'Inter', system-ui, -apple-system, 'Segoe UI', 'Geist', sans-serif;
    --ds-font-mono:  'JetBrains Mono', 'IBM Plex Mono', ui-monospace, 'SF Mono', monospace;
    --ds-font-serif: 'Geist', Georgia, serif;
    --ds-font-size-2xs: 10px;
    --ds-font-size-xs:  11px;
    --ds-font-size-sm:  12px;
    --ds-font-size-md:  13px;
    --ds-font-size-lg:  14px;
    --ds-font-size-xl:  16px;
    --ds-font-size-2xl: 20px;
    --ds-font-size-3xl: 28px;
    --ds-font-size-4xl: 40px;
    --ds-font-size-5xl: 56px;
    --ds-font-variant-tabular: tabular-nums;
    --ds-radius-sm:   3px;
    --ds-radius-md:   3px;
    --ds-radius-lg:   3px;
    --ds-radius-xl:   6px;
    --ds-radius-full: 9999px;
    --radius:         3px;

    /* ── Motion vars (Stockflux tokens.css) ── */
    --ds-tx-instant: 80ms cubic-bezier(0.4,0,0.6,1);
    --ds-tx-fast:    140ms cubic-bezier(0.4,0,0.2,1);
    --ds-tx-normal:  220ms cubic-bezier(0.4,0,0.2,1);
    --ds-tx-slow:    420ms cubic-bezier(0.4,0,0.2,1);
    --ds-tx-tick:    900ms cubic-bezier(0.25,0.1,0.25,1);
    --sf-t-instant:  80ms cubic-bezier(0.4,0,0.6,1);
    --sf-t-fast:     140ms cubic-bezier(0.4,0,0.2,1);
    --sf-t-normal:   220ms cubic-bezier(0.4,0,0.2,1);
    --sf-t-slow:     420ms cubic-bezier(0.4,0,0.2,1);
    --sf-t-tick:     900ms cubic-bezier(0.25,0.1,0.25,1);

    /* ── Control density tiers (compact controls — see tokens/controls.ts) ── */
    --ds-control-xs-height:       24px;
    --ds-control-xs-padding-x:    8px;
    --ds-control-xs-gap:          4px;
    --ds-control-xs-font-size:    12px;
    --ds-control-xs-icon-size:    12px;
    --ds-control-xs-radius:       3px;
    --ds-control-sm-height:       26px;
    --ds-control-sm-padding-x:    10px;
    --ds-control-sm-gap:          6px;
    --ds-control-sm-font-size:    12px;
    --ds-control-sm-icon-size:    14px;
    --ds-control-sm-radius:       3px;
    --ds-control-md-height:       28px;
    --ds-control-md-padding-x:    12px;
    --ds-control-md-gap:          6px;
    --ds-control-md-font-size:    13px;
    --ds-control-md-icon-size:    14px;
    --ds-control-md-radius:       3px;
    --ds-control-lg-height:       30px;
    --ds-control-lg-padding-x:    12px;
    --ds-control-lg-gap:          8px;
    --ds-control-lg-font-size:    13px;
    --ds-control-lg-icon-size:    16px;
    --ds-control-lg-radius:       3px;

    /* ── Legacy bn-* / fi-* aliases (apps + cell renderers) ── */
    --bn-bg:        #f3f7f9;
    --bn-bg-sunken: #ffffff;
    --bn-bg1:       #ffffff;
    --bn-bg2:       #eef3f6;
    --bn-bg3:       #e3ecf0;
    --bn-bg4:       #d4e0e7;
    --bn-t0:        #06121f;
    --bn-t1:        #1c344d;
    --bn-t2:        #3e5663;
    --bn-t3:        #7d92a0;
    --bn-t4:        #b1bfc8;
    --bn-border:    #c5d1da;
    --bn-border2:   #a6b6c2;
    --bn-border3:   #98aab6;
    --bn-green:     #0f766e;
    --bn-green2:    #0a5d56;
    --bn-red:       #be1f43;
    --bn-red2:      #9e1838;
    --bn-amber:     #b27607;
    --bn-blue:      #0f766e;
    --bn-blue2:     #0a5d56;
    --bn-info:      #0e7490;
    --bn-cyan:      #06b6d4;
    --bn-purple:    #7631c4;
    --bn-buy-bg:    #0f766e;
    --bn-sell-bg:   #be1f43;
    --bn-cta-text:  #ffffff;
    --ob-bid-fill:  rgba(15,118,110,0.13);
    --ob-ask-fill:  rgba(190,31,67,0.11);
    --tt-bid-strip: rgba(15,118,110,0.05);
    --tt-ask-strip: rgba(190,31,67,0.05);
    
    /* ── Stockflux --sf-* aliases (SLATE BLUE) ── */
    --sf-bg:        #f3f7f9;
    --sf-bg-1:      #ffffff;
    --sf-bg-2:      #ffffff;
    --sf-bg-3:      #eef3f6;
    --sf-bg-4:      #e3ecf0;
    --sf-bg-5:      #d4e0e7;
    --sf-t-0:       #06121f;
    --sf-t-1:       #1c344d;
    --sf-t-2:       #3e5663;
    --sf-t-3:       #7d92a0;
    --sf-t-4:       #b1bfc8;
    --sf-border:    #c5d1da;
    --sf-border-2:  #a6b6c2;
    --sf-border-3:  #98aab6;
    --sf-teal:      #0f766e;
    --sf-teal-hi:   #0a5d56;
    --sf-teal-lo:   #115e54;
    --sf-teal-soft: rgba(15,118,110,0.10);
    --sf-teal-ring: rgba(15,118,110,0.32);
    --sf-up:        #0f766e;
    --sf-up-hi:     #0a5d56;
    --sf-up-soft:   rgba(15,118,110,0.10);
    --sf-up-strip:  rgba(15,118,110,0.05);
    --sf-down:      #be1f43;
    --sf-down-hi:   #9e1838;
    --sf-down-soft: rgba(190,31,67,0.10);
    --sf-down-strip:rgba(190,31,67,0.05);
    --sf-flat:      #3e5663;
    --sf-info:      #0e7490;
    --sf-info-soft: rgba(14,116,144,0.10);
    --sf-warn:      #b27607;
    --sf-warn-soft: rgba(178,118,7,0.11);
    --sf-success:   #0f766e;
    --sf-error:     #be1f43;
    --sf-bid-fill:  rgba(15,118,110,0.13);
    --sf-ask-fill:  rgba(190,31,67,0.11);
    --sf-scrollbar: #a6b6c2;
  }

