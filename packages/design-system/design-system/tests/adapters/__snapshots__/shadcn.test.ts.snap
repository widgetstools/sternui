    --ds-chart-2: #2dd4bf;
    --ds-chart-3: #f5c14b;
    --ds-chart-4: #af7de8;
    --ds-chart-5: #f25668;

    /* ── shadcn-compat HSL channel aliases (Stockflux SLATE BLUE) ── */
    --background:             215 39% 10%;
    --foreground:             218 27% 92%;
    --card:                   215 35% 12%;
    --card-foreground:        218 27% 92%;
