    --tt-bid-strip: rgba(15,118,110,0.04);
    --tt-ask-strip: rgba(190,31,67,0.04);
    
    /* ── Stockflux --sf-* aliases (SLATE BLUE) ── */
    --sf-bg:        #f1f3f6;
    --sf-bg-1:      #ffffff;
    --sf-bg-2:      #ffffff;
    --sf-bg-3:      #e9ecf0;
    --sf-bg-4:      #dde1e7;
    --sf-bg-5:      #c8cdd5;
    --sf-t-0:       #18222f;
    --sf-t-1:       #2f3a4a;
    --sf-t-2:       #525d6c;
    --sf-t-3:       #7a8392;
    --sf-t-4:       #abb1bb;
    --sf-border:    #d4d8de;
    --sf-border-2:  #b6bbc4;
    --sf-border-3:  #8e94a0;
    --sf-teal:      #2563eb;
    --sf-teal-hi:   #1d4ed8;
    --sf-teal-lo:   #1e40af;
    --sf-teal-soft: rgba(37,99,235,0.10);
    --sf-teal-ring: rgba(37,99,235,0.28);
    --sf-up:        #0f766e;
    --sf-up-hi:     #0a5d56;
    --sf-up-soft:   rgba(15,118,110,0.10);
    --sf-up-strip:  rgba(15,118,110,0.04);
    --sf-down:      #be1f43;
