    --ds-border-secondary: #a8aab4;
    --ds-border-tertiary:  #94969d;

    --ds-accent-positive:       #0f766e;
    --ds-accent-positive-hover: #0a5d56;
    --ds-accent-negative:       #be1f43;
    --ds-accent-negative-hover: #9e1838;
    --ds-accent-warning:        #b27607;
    --ds-accent-info:           #0e7490;
    --ds-accent-info-hover:     #0c6378;
    --ds-accent-highlight:      #06b6d4;
    --ds-accent-purple:         #7631c4;

    --ds-action-buy-bg:    #0f766e;
    --ds-action-buy-fg:    #ffffff;
    --ds-action-sell-bg:   #be1f43;
    --ds-action-sell-fg:   #ffffff;

    --ds-state-focus-ring:    #4f46e5;
    --ds-state-focus-ring-bg: rgba(79,70,229,0.10);
    --ds-state-disabled-bg:   #e2e3e8;
    --ds-state-disabled-fg:   #aaadb4;
    --ds-state-hover-overlay: rgba(0,0,0,0.045);
    --ds-state-selection:     rgba(79,70,229,0.10);

    --ds-overlay-positive-soft:  rgba(15,118,110,0.10);
    --ds-overlay-positive-ring:  rgba(15,118,110,0.10);
    --ds-overlay-negative-soft:  rgba(190,31,67,0.10);
    --ds-overlay-negative-ring:  rgba(190,31,67,0.10);
    --ds-overlay-warning-soft:   rgba(178,118,7,0.11);
    --ds-overlay-warning-ring:   rgba(178,118,7,0.11);
    --ds-overlay-info-soft:      rgba(14,116,144,0.10);
    --ds-overlay-info-ring:      rgba(14,116,144,0.10);
    --ds-overlay-neutral-soft:   rgba(82,93,108,0.08);
    --ds-overlay-neutral-ring:   rgba(82,93,108,0.14);

    --ds-scrollbar:  #a8aab4;

    --ds-elevation-card:    0 1px 2px rgba(12,29,48,0.06);
    --ds-elevation-overlay: 0 2px 8px rgba(12,29,48,0.08), 0 1px 0 rgba(255,255,255,0.6) inset;
    --ds-elevation-glow:    0 0 0 3px rgba(79,70,229,0.28);

    --ds-trade-flat:           #51545c;
    --ds-trade-positive-strip: rgba(15,118,110,0.04);
    --ds-trade-negative-strip: rgba(190,31,67,0.04);
    --ds-trade-bid-fill:       rgba(15,118,110,0.13);
    --ds-trade-ask-fill:       rgba(190,31,67,0.11);

    --ds-chart-1: #4f46e5;
    --ds-chart-2: #0f766e;
    --ds-chart-3: #b27607;
    --ds-chart-4: #7631c4;
    --ds-chart-5: #be1f43;

    /* ── shadcn-compat HSL channel aliases (Stockflux SLATE BLUE) ── */
    --background:             232 10% 97%;
    --foreground:             232 14% 12%;
    --card:                   0 0% 100%;
    --card-foreground:        232 14% 12%;
    --popover:                0 0% 100%;
    --popover-foreground:     232 14% 12%;
    --primary:                239 84% 56%;
    --primary-foreground:     0 0% 100%;
    --secondary:              232 8% 92%;
    --secondary-foreground:   232 14% 18%;
    --muted:                  232 8% 92%;
    --muted-foreground:       232 6% 38%;
    --accent:                 239 84% 56%;
    --accent-foreground:      0 0% 100%;
    --destructive:            350 78% 42%;
    --destructive-foreground: 0 0% 100%;
    --success:                175 77% 26%;
    --success-foreground:     0 0% 100%;
    --warning:                39 92% 36%;
    --warning-foreground:     0 0% 100%;
    --info:                   193 82% 31%;
    --info-foreground:        0 0% 100%;
    --border:                 232 7% 84%;
    --input:                  232 7% 84%;
    --ring:                   239 84% 56%;

    --sidebar-background:              232 10% 97%;
    --sidebar-foreground:              232 14% 12%;
    --sidebar-primary:                 239 84% 56%;
    --sidebar-primary-foreground:      0 0% 100%;
    --sidebar-accent:                  232 8% 92%;
    --sidebar-accent-foreground:       232 14% 18%;
    --sidebar-border:                  232 7% 84%;
    --sidebar-ring:                    239 84% 56%;

    --chart-1: 239 84% 56%;
    --chart-2: 172 76% 32%;
    --chart-3: 199 89% 38%;
    --chart-4: 35 85% 42%;
    --chart-5: 350 78% 42%;

    --surface-50:  0 0% 100%;
    --surface-100: 225 12% 94%;
    --surface-200: 230 12% 90%;
    --surface-300: 227 10% 82%;
    --surface-400: 230 7% 68%;
    --surface-500: 225 8% 80%;
    --surface-600: 224 4% 50%;
    --surface-700: 224 6% 34%;
    --surface-800: 224 15% 14%;
    --surface-900: 223 13% 11%;
    --surface-950: 240 11% 96%;

    /* ── PrimeNG var bridge (for tailwindcss-primeui) ── */
    --p-primary-color:        #4f46e5;
    --p-primary-color-text:   #ffffff;
    --p-surface-50:           #ffffff;
    --p-surface-100:          #edeef1;
    --p-surface-200:          #e2e3e8;
    --p-surface-900:          #181a1f;
    --p-surface-950:          #f5f5f7;
    --p-text-color:           #181a1f;
    --p-text-muted-color:     #51545c;
    --p-content-background:   #ffffff;
    --p-content-border-color: #c8cad0;
    --p-content-color:        #181a1f;

    /* ── Typography vars ── */
    --ds-font-sans:  'Inter', system-ui, -apple-system, 'Segoe UI', 'Geist', sans-serif;
    --ds-font-mono:  'JetBrains Mono', 'IBM Plex Mono', ui-monospace, 'SF Mono', monospace;
    --ds-font-serif: 'Geist', Georgia, serif;
    --ds-font-size-2xs: 10px;
    --ds-font-size-xs:  11px;
    --ds-font-size-sm:  12px;
    --ds-font-size-md:  13px;
    --ds-font-size-lg:  14px;
    --ds-font-size-xl:  16px;
    --ds-font-size-2xl: 20px;
    --ds-font-size-3xl: 28px;
    --ds-font-size-4xl: 40px;
    --ds-font-size-5xl: 56px;
    --ds-font-variant-tabular: tabular-nums;
    --ds-radius-sm:   3px;
    --ds-radius-md:   3px;
    --ds-radius-lg:   3px;
    --ds-radius-xl:   6px;
    --ds-radius-full: 9999px;
    --radius:         3px;

    /* ── Motion vars (Stockflux tokens.css) ── */
    --ds-tx-instant: 80ms cubic-bezier(0.4,0,0.6,1);
    --ds-tx-fast:    140ms cubic-bezier(0.4,0,0.2,1);
    --ds-tx-normal:  220ms cubic-bezier(0.4,0,0.2,1);
    --ds-tx-slow:    420ms cubic-bezier(0.4,0,0.2,1);
    --ds-tx-tick:    900ms cubic-bezier(0.25,0.1,0.25,1);
    --sf-t-instant:  80ms cubic-bezier(0.4,0,0.6,1);
    --sf-t-fast:     140ms cubic-bezier(0.4,0,0.2,1);
    --sf-t-normal:   220ms cubic-bezier(0.4,0,0.2,1);
    --sf-t-slow:     420ms cubic-bezier(0.4,0,0.2,1);
    --sf-t-tick:     900ms cubic-bezier(0.25,0.1,0.25,1);

    /* ── Control density tiers (compact controls — see tokens/controls.ts) ── */
    --ds-control-xs-height:       24px;
    --ds-control-xs-padding-x:    8px;
    --ds-control-xs-gap:          4px;
    --ds-control-xs-font-size:    12px;
    --ds-control-xs-icon-size:    12px;
    --ds-control-xs-radius:       3px;
    --ds-control-sm-height:       26px;
    --ds-control-sm-padding-x:    10px;
    --ds-control-sm-gap:          6px;
    --ds-control-sm-font-size:    12px;
    --ds-control-sm-icon-size:    14px;
    --ds-control-sm-radius:       3px;
    --ds-control-md-height:       28px;
    --ds-control-md-padding-x:    12px;
    --ds-control-md-gap:          6px;
    --ds-control-md-font-size:    13px;
    --ds-control-md-icon-size:    14px;
    --ds-control-md-radius:       3px;
    --ds-control-lg-height:       30px;
    --ds-control-lg-padding-x:    12px;
    --ds-control-lg-gap:          8px;
    --ds-control-lg-font-size:    13px;
    --ds-control-lg-icon-size:    16px;
    --ds-control-lg-radius:       3px;

    /* ── Legacy bn-* / fi-* aliases (apps + cell renderers) ── */
    --bn-bg:        #f5f5f7;
    --bn-bg-sunken: #ffffff;
    --bn-bg1:       #ffffff;
    --bn-bg2:       #edeef1;
    --bn-bg3:       #e2e3e8;
    --bn-bg4:       #cdcfd6;
    --bn-t0:        #181a1f;
    --bn-t1:        #1f222a;
    --bn-t2:        #51545c;
    --bn-t3:        #797c84;
    --bn-t4:        #aaadb4;
    --bn-border:    #c8cad0;
    --bn-border2:   #a8aab4;
    --bn-border3:   #94969d;
    --bn-green:     #0f766e;
    --bn-green2:    #0a5d56;
    --bn-red:       #be1f43;
    --bn-red2:      #9e1838;
    --bn-amber:     #b27607;
    --bn-blue:      #4f46e5;
    --bn-blue2:     #4338ca;
    --bn-info:      #0e7490;
    --bn-cyan:      #06b6d4;
    --bn-purple:    #7631c4;
    --bn-buy-bg:    #0f766e;
    --bn-sell-bg:   #be1f43;
    --bn-cta-text:  #ffffff;
    --ob-bid-fill:  rgba(15,118,110,0.13);
    --ob-ask-fill:  rgba(190,31,67,0.11);
    --tt-bid-strip: rgba(15,118,110,0.04);
    --tt-ask-strip: rgba(190,31,67,0.04);
    
    /* ── Stockflux --sf-* aliases (SLATE BLUE) ── */
    --sf-bg:        #f5f5f7;
    --sf-bg-1:      #ffffff;
    --sf-bg-2:      #ffffff;
    --sf-bg-3:      #edeef1;
    --sf-bg-4:      #e2e3e8;
    --sf-bg-5:      #cdcfd6;
    --sf-t-0:       #181a1f;
    --sf-t-1:       #1f222a;
    --sf-t-2:       #51545c;
    --sf-t-3:       #797c84;
    --sf-t-4:       #aaadb4;
    --sf-border:    #c8cad0;
    --sf-border-2:  #a8aab4;
    --sf-border-3:  #94969d;
    --sf-teal:      #4f46e5;
    --sf-teal-hi:   #4338ca;
    --sf-teal-lo:   #3730a3;
    --sf-teal-soft: rgba(79,70,229,0.10);
    --sf-teal-ring: rgba(79,70,229,0.28);
    --sf-up:        #0f766e;
    --sf-up-hi:     #0a5d56;
    --sf-up-soft:   rgba(15,118,110,0.10);
    --sf-up-strip:  rgba(15,118,110,0.04);
    --sf-down:      #be1f43;
    --sf-down-hi:   #9e1838;
    --sf-down-soft: rgba(190,31,67,0.10);
    --sf-down-strip:rgba(190,31,67,0.04);
    --sf-flat:      #51545c;
    --sf-info:      #0e7490;
    --sf-info-soft: rgba(14,116,144,0.10);
    --sf-warn:      #b27607;
    --sf-warn-soft: rgba(178,118,7,0.11);
    --sf-success:   #0f766e;
    --sf-error:     #be1f43;
    --sf-bid-fill:  rgba(15,118,110,0.13);
    --sf-ask-fill:  rgba(190,31,67,0.11);
    --sf-scrollbar: #a8aab4;
  }

  [data-palette="indigo"][data-theme="dark"][data-cvd="on"] {
    --ds-accent-positive:       #7aa6ff;
    --ds-accent-positive-hover: #7aa6ff;
    --ds-accent-negative:       #ff9d4e;
    --ds-accent-negative-hover: #ff9d4e;
    --ds-action-buy-bg:         #7aa6ff;
    --ds-action-sell-bg:        #ff9d4e;
    --success:                  220 100% 74%;
    --destructive:              27 100% 65%;
  }

  [data-palette="indigo"][data-theme="light"][data-cvd="on"] {
    --ds-accent-positive:       #1e4fb8;
    --ds-accent-positive-hover: #1e4fb8;
    --ds-accent-negative:       #c2410c;
    --ds-accent-negative-hover: #c2410c;
    --ds-action-buy-bg:         #1e4fb8;
    --ds-action-sell-bg:        #c2410c;
    --success:                  221 72% 42%;
    --destructive:              17 88% 40%;
  }
  [data-palette="amber"][data-theme="dark"] {
    /* ── FI Design System source tokens ── */
    --ds-primary:           #f59e0b;
