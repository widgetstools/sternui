    --accent:                 192 91% 36%;
    --accent-foreground:      0 0% 100%;
    --destructive:            347 77% 50%;
    --destructive-foreground: 0 0% 100%;
    --success:                175 84% 32%;
    --success-foreground:     0 0% 100%;
    --warning:                17 88% 40%;
    --warning-foreground:     0 0% 100%;
    --info:                   192 91% 36%;
    --info-foreground:        0 0% 100%;
    --border:                 212 23% 89%;
    --input:                  212 23% 89%;
    --ring:                   192 91% 36%;

    --sidebar-background:              210 22% 96%;
    --sidebar-foreground:              222 47% 11%;
    --sidebar-primary:                 192 91% 36%;
    --sidebar-primary-foreground:      0 0% 100%;
    --sidebar-accent:                  210 21% 95%;
    --sidebar-accent-foreground:       222 47% 11%;
    --sidebar-border:                  212 23% 89%;
    --sidebar-ring:                    192 91% 36%;

    --chart-1: 192 91% 36%;
    --chart-2: 175 84% 32%;
    --chart-3: 17 88% 40%;
    --chart-4: 262 83% 58%;
    --chart-5: 347 77% 50%;

    --surface-50:  0 0% 100%;
    --surface-100: 210 21% 95%;
    --surface-200: 213 24% 91%;
    --surface-300: 213 17% 80%;
    --surface-400: 213 17% 80%;
    --surface-500: 212 23% 89%;
    --surface-600: 215 20% 65%;
    --surface-700: 215 16% 47%;
    --surface-800: 215 25% 27%;
    --surface-900: 222 47% 11%;
    --surface-950: 210 22% 96%;

    /* ── PrimeNG var bridge (for tailwindcss-primeui) ── */
    --p-primary-color:        #0891b2;
    --p-primary-color-text:   #ffffff;
    --p-surface-50:           #ffffff;
    --p-surface-100:          #eef1f4;
    --p-surface-200:          #e3e8ee;
    --p-surface-900:          #0f172a;
    --p-surface-950:          #f4f6f8;
    --p-text-color:           #0f172a;
    --p-text-muted-color:     #64748b;
    --p-content-background:   #ffffff;
    --p-content-border-color: #dce2e9;
    --p-content-color:        #0f172a;

    /* ── Typography vars ── */
    --ds-font-sans:  'Inter', system-ui, -apple-system, 'Segoe UI', 'Geist', sans-serif;
    --ds-font-mono:  'JetBrains Mono', 'IBM Plex Mono', ui-monospace, 'SF Mono', monospace;
    --ds-font-serif: 'Geist', Georgia, serif;
    --ds-font-size-2xs: 10px;
    --ds-font-size-xs:  11px;
    --ds-font-size-sm:  12px;
    --ds-font-size-md:  13px;
    --ds-font-size-lg:  14px;
    --ds-font-size-xl:  16px;
    --ds-font-size-2xl: 20px;
    --ds-font-size-3xl: 28px;
    --ds-font-size-4xl: 40px;
    --ds-font-size-5xl: 56px;
    --ds-font-variant-tabular: tabular-nums;
    --ds-radius-sm:   2px;
    --ds-radius-md:   2px;
    --ds-radius-lg:   2px;
    --ds-radius-xl:   2px;
    --ds-radius-full: 9999px;
    --radius:         2px;

    /* ── Motion vars (Stockflux tokens.css) ── */
    --ds-tx-instant: 80ms cubic-bezier(0.4,0,0.6,1);
    --ds-tx-fast:    140ms cubic-bezier(0.4,0,0.2,1);
    --ds-tx-normal:  220ms cubic-bezier(0.4,0,0.2,1);
    --ds-tx-slow:    420ms cubic-bezier(0.4,0,0.2,1);
    --ds-tx-tick:    900ms cubic-bezier(0.25,0.1,0.25,1);
    --sf-t-instant:  80ms cubic-bezier(0.4,0,0.6,1);
    --sf-t-fast:     140ms cubic-bezier(0.4,0,0.2,1);
    --sf-t-normal:   220ms cubic-bezier(0.4,0,0.2,1);
    --sf-t-slow:     420ms cubic-bezier(0.4,0,0.2,1);
    --sf-t-tick:     900ms cubic-bezier(0.25,0.1,0.25,1);

    /* ── Control density tiers (compact controls — see tokens/controls.ts) ── */
    --ds-control-xs-height:       24px;
    --ds-control-xs-padding-x:    8px;
    --ds-control-xs-gap:          4px;
    --ds-control-xs-font-size:    12px;
    --ds-control-xs-icon-size:    12px;
    --ds-control-xs-radius:       2px;
    --ds-control-sm-height:       26px;
    --ds-control-sm-padding-x:    10px;
    --ds-control-sm-gap:          6px;
    --ds-control-sm-font-size:    12px;
    --ds-control-sm-icon-size:    14px;
    --ds-control-sm-radius:       2px;
    --ds-control-md-height:       28px;
    --ds-control-md-padding-x:    12px;
    --ds-control-md-gap:          6px;
    --ds-control-md-font-size:    13px;
    --ds-control-md-icon-size:    14px;
    --ds-control-md-radius:       2px;
    --ds-control-lg-height:       30px;
    --ds-control-lg-padding-x:    12px;
    --ds-control-lg-gap:          8px;
    --ds-control-lg-font-size:    13px;
    --ds-control-lg-icon-size:    16px;
    --ds-control-lg-radius:       2px;

    /* ── Legacy bn-* / fi-* aliases (apps + cell renderers) ── */
    --bn-bg:        #f4f6f8;
    --bn-bg-sunken: #ffffff;
    --bn-bg1:       #ffffff;
    --bn-bg2:       #eef1f4;
    --bn-bg3:       #e3e8ee;
    --bn-bg4:       #c2cad4;
    --bn-t0:        #0f172a;
    --bn-t1:        #334155;
    --bn-t2:        #64748b;
    --bn-t3:        #94a3b8;
    --bn-t4:        #94a3b8;
    --bn-border:    #dce2e9;
    --bn-border2:   #c2cad4;
    --bn-border3:   #c2cad4;
    --bn-green:     #0d9488;
    --bn-green2:    #0b7a70;
    --bn-red:       #e11d48;
    --bn-red2:      #be123c;
    --bn-amber:     #c2410c;
    --bn-blue:      #0891b2;
    --bn-blue2:     #0e7490;
    --bn-info:      #0891b2;
    --bn-cyan:      #0891b2;
    --bn-purple:    #7c3aed;
    --bn-buy-bg:    #0d9488;
    --bn-sell-bg:   #e11d48;
    --bn-cta-text:  #ffffff;
    --ob-bid-fill:  rgba(13,148,136,0.10);
    --ob-ask-fill:  rgba(225,29,72,0.09);
    --tt-bid-strip: rgba(13,148,136,0.10);
    --tt-ask-strip: rgba(225,29,72,0.09);
    
    /* ── STARUI --st-* source tokens ── */
    --st-bg:           #f4f6f8;
    --st-bg-1:         #ffffff;
    --st-bg-2:         #eef1f4;
    --st-bg-3:         #e3e8ee;
    --st-t0:           #0f172a;
    --st-t1:           #334155;
    --st-t2:           #64748b;
    --st-t3:           #94a3b8;
    --st-border:       #dce2e9;
    --st-border-2:     #c2cad4;
    --st-divider:      #eef1f4;
    --st-accent:       #0891b2;
    --st-accent-hover: #0e7490;
    --st-accent-fg:    #ffffff;
    --st-accent-soft:  rgba(8,145,178,0.10);
    --st-accent-ring:  rgba(8,145,178,0.32);
    --st-buy:          #0d9488;
    --st-buy-hover:    #0b7a70;
    --st-buy-fg:       #ffffff;
    --st-buy-soft:     rgba(13,148,136,0.10);
    --st-buy-ring:     rgba(13,148,136,0.32);
    --st-sell:         #e11d48;
    --st-sell-hover:   #be123c;
    --st-sell-fg:      #ffffff;
    --st-sell-soft:    rgba(225,29,72,0.09);
    --st-sell-ring:    rgba(225,29,72,0.30);
    --st-warn:         #c2410c;
    --st-warn-soft:    rgba(194,65,12,0.10);
    --st-warn-ring:    rgba(194,65,12,0.32);
    --st-info:         #0891b2;
    --st-info-soft:    rgba(8,145,178,0.09);
    --st-info-ring:    rgba(8,145,178,0.30);
    --st-purple:       #7c3aed;
    --st-neutral-soft: rgba(51,65,85,0.07);
    --st-neutral-ring: rgba(51,65,85,0.20);
    --st-hover-overlay:rgba(15,23,42,0.04);
    --st-selection:    rgba(8,145,178,0.16);
    --st-disabled-bg:  #eef1f4;
    --st-disabled-fg:  #94a3b8;
    --st-scrollbar:    #c2cad4;
    --st-ob-bid:       rgba(13,148,136,0.10);
    --st-ob-ask:       rgba(225,29,72,0.09);
    --st-shadow-card:    0 1px 2px rgba(15,23,42,0.06);
    --st-shadow-overlay: 0 1px 2px rgba(15,23,42,0.08), 0 8px 22px rgba(15,23,42,0.10);
    --st-glow-focus:     0 0 0 3px rgba(8,145,178,0.18);
    --st-font-sans:  'Inter', system-ui, -apple-system, 'Segoe UI', 'Geist', sans-serif;
    --st-font-mono:  'JetBrains Mono', 'IBM Plex Mono', ui-monospace, 'SF Mono', monospace;
    --st-radius:     2px;
    --st-radius-sm:  2px;
    --st-radius-md:  2px;
    --st-radius-lg:  2px;
    --st-t-instant:  80ms cubic-bezier(0.4,0,0.6,1);
    --st-t-fast:     140ms cubic-bezier(0.4,0,0.2,1);
    --st-t-normal:   220ms cubic-bezier(0.4,0,0.2,1);
    --st-t-slow:     420ms cubic-bezier(0.4,0,0.2,1);
    --st-t-tick:     900ms cubic-bezier(0.25,0.1,0.25,1);
    
    /* ── Stockflux --sf-* aliases (SLATE BLUE) ── */
    --sf-bg:        #f4f6f8;
    --sf-bg-1:      #ffffff;
    --sf-bg-2:      #ffffff;
    --sf-bg-3:      #eef1f4;
    --sf-bg-4:      #e3e8ee;
    --sf-bg-5:      #c2cad4;
    --sf-t-0:       #0f172a;
    --sf-t-1:       #334155;
    --sf-t-2:       #64748b;
    --sf-t-3:       #94a3b8;
    --sf-t-4:       #94a3b8;
    --sf-border:    #dce2e9;
    --sf-border-2:  #c2cad4;
    --sf-border-3:  #c2cad4;
    --sf-teal:      #0891b2;
    --sf-teal-hi:   #0e7490;
    --sf-teal-lo:   #0e7490;
    --sf-teal-soft: rgba(8,145,178,0.10);
    --sf-teal-ring: rgba(8,145,178,0.32);
    --sf-up:        #0d9488;
    --sf-up-hi:     #0b7a70;
    --sf-up-soft:   rgba(13,148,136,0.10);
    --sf-up-strip:  rgba(13,148,136,0.10);
    --sf-down:      #e11d48;
    --sf-down-hi:   #be123c;
    --sf-down-soft: rgba(225,29,72,0.09);
    --sf-down-strip:rgba(225,29,72,0.09);
    --sf-flat:      #64748b;
    --sf-info:      #0891b2;
    --sf-info-soft: rgba(8,145,178,0.09);
    --sf-warn:      #c2410c;
    --sf-warn-soft: rgba(194,65,12,0.10);
    --sf-success:   #0d9488;
    --sf-error:     #e11d48;
    --sf-bid-fill:  rgba(13,148,136,0.10);
    --sf-ask-fill:  rgba(225,29,72,0.09);
    --sf-scrollbar: #c2cad4;
  }

  [data-theme="light"][data-variant="paper"] {
    /* ── FI Design System source tokens ── */
    --ds-primary:           #0e7490;
    --ds-primary-hover:     #155e75;
    --ds-primary-display:   #0e7490;
    --ds-primary-highlight: #155e75;
    --ds-primary-pressed:   #155e75;
    --ds-primary-foreground:#ffffff;
    --ds-primary-soft:      rgba(14,116,144,0.10);
    --ds-primary-ring:      rgba(14,116,144,0.32);

    --ds-surface-ground:     #efede9;
    --ds-surface-sunken:     #fbf8f2;
    --ds-surface-primary:    #fbf8f2;
    --ds-surface-secondary:  #ece6da;
    --ds-surface-tertiary:   #e0d8c8;
    --ds-surface-quaternary: #b4a98f;

    --ds-text-primary:   #2a2519;
    --ds-text-secondary: #524a38;
    --ds-text-muted:     #6d6550;
    --ds-text-faint:     #8a806a;
    --ds-text-disabled:  #8a806a;

    --ds-border-primary:   #d3c9b5;
    --ds-border-secondary: #b4a98f;
    --ds-border-tertiary:  #b4a98f;

    --ds-accent-positive:       #0f766e;
    --ds-accent-positive-hover: #0c5e58;
    --ds-accent-negative:       #be123c;
    --ds-accent-negative-hover: #9f0f33;
    --ds-accent-warning:        #b45309;
    --ds-accent-info:           #0e7490;
    --ds-accent-info-hover:     #155e75;
    --ds-accent-highlight:      #0e7490;
    --ds-accent-purple:         #6d28d9;

    --ds-action-buy-bg:    #0f766e;
    --ds-action-buy-fg:    #ffffff;
    --ds-action-sell-bg:   #be123c;
    --ds-action-sell-fg:   #ffffff;

    --ds-state-focus-ring:    #0e7490;
    --ds-state-focus-ring-bg: rgba(14,116,144,0.10);
    --ds-state-disabled-bg:   #ece6da;
    --ds-state-disabled-fg:   #8a806a;
    --ds-state-hover-overlay: rgba(42,37,25,0.045);
    --ds-state-selection:     rgba(14,116,144,0.16);

    --ds-overlay-positive-soft:  rgba(15,118,110,0.10);
    --ds-overlay-positive-ring:  rgba(15,118,110,0.32);
    --ds-overlay-negative-soft:  rgba(190,18,60,0.09);
    --ds-overlay-negative-ring:  rgba(190,18,60,0.30);
    --ds-overlay-warning-soft:   rgba(180,83,9,0.10);
    --ds-overlay-warning-ring:   rgba(180,83,9,0.32);
    --ds-overlay-info-soft:      rgba(14,116,144,0.09);
    --ds-overlay-info-ring:      rgba(14,116,144,0.30);
    --ds-overlay-neutral-soft:   rgba(82,74,56,0.07);
    --ds-overlay-neutral-ring:   rgba(82,74,56,0.22);

    --ds-scrollbar:  #b4a98f;

    --ds-elevation-card:    0 1px 2px rgba(42,37,25,0.06);
    --ds-elevation-overlay: 0 1px 2px rgba(42,37,25,0.08), 0 8px 22px rgba(42,37,25,0.12);
    --ds-elevation-glow:    0 0 0 3px rgba(14,116,144,0.18);

    --ds-trade-flat:           #6d6550;
    --ds-trade-positive-strip: rgba(15,118,110,0.10);
    --ds-trade-negative-strip: rgba(190,18,60,0.09);
    --ds-trade-bid-fill:       rgba(15,118,110,0.11);
    --ds-trade-ask-fill:       rgba(190,18,60,0.10);

    --ds-chart-1: #0e7490;
    --ds-chart-2: #0f766e;
    --ds-chart-3: #b45309;
    --ds-chart-4: #6d28d9;
    --ds-chart-5: #be123c;

    /* ── shadcn-compat HSL channel aliases (Stockflux SLATE BLUE) ── */
    --background:             40 16% 93%;
    --foreground:             42 25% 13%;
    --card:                   40 53% 97%;
    --card-foreground:        42 25% 13%;
    --popover:                40 53% 97%;
    --popover-foreground:     42 25% 13%;
    --primary:                193 82% 31%;
    --primary-foreground:     0 0% 100%;
    --secondary:              40 32% 89%;
    --secondary-foreground:   42 19% 27%;
    --muted:                  40 32% 89%;
    --muted-foreground:       43 15% 37%;
    --accent:                 193 82% 31%;
    --accent-foreground:      0 0% 100%;
    --destructive:            345 83% 41%;
    --destructive-foreground: 0 0% 100%;
    --success:                175 77% 26%;
    --success-foreground:     0 0% 100%;
    --warning:                26 90% 37%;
    --warning-foreground:     0 0% 100%;
    --info:                   193 82% 31%;
    --info-foreground:        0 0% 100%;
    --border:                 40 25% 77%;
    --input:                  40 25% 77%;
    --ring:                   193 82% 31%;

    --sidebar-background:              40 16% 93%;
    --sidebar-foreground:              42 25% 13%;
    --sidebar-primary:                 193 82% 31%;
    --sidebar-primary-foreground:      0 0% 100%;
    --sidebar-accent:                  40 32% 89%;
    --sidebar-accent-foreground:       42 25% 13%;
    --sidebar-border:                  40 25% 77%;
    --sidebar-ring:                    193 82% 31%;

    --chart-1: 193 82% 31%;
    --chart-2: 175 77% 26%;
    --chart-3: 26 90% 37%;
    --chart-4: 263 70% 50%;
    --chart-5: 345 83% 41%;

    --surface-50:  40 53% 97%;
    --surface-100: 40 32% 89%;
    --surface-200: 40 28% 83%;
    --surface-300: 42 20% 63%;
    --surface-400: 42 20% 63%;
