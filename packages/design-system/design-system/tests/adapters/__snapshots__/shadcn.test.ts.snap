// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`generateUnifiedCSS > matches snapshot 1`] = `
"@layer base {
  :root, [data-theme="dark"] {
    /* ── FI Design System source tokens ── */
    --ds-primary:           #22d3ee;
    --ds-primary-hover:     #4ae0f2;
    --ds-primary-display:   #22d3ee;
    --ds-primary-highlight: #4ae0f2;
    --ds-primary-pressed:   #4ae0f2;
    --ds-primary-foreground:#06232b;
    --ds-primary-soft:      rgba(34,211,238,0.12);
    --ds-primary-ring:      rgba(34,211,238,0.45);

    --ds-surface-ground:     #20262e;
    --ds-surface-sunken:     #2a3038;
    --ds-surface-primary:    #2a3038;
    --ds-surface-secondary:  #323942;
    --ds-surface-tertiary:   #3b434e;
    --ds-surface-quaternary: #545d6f;

    --ds-text-primary:   #ecf0f5;
    --ds-text-secondary: #aab3bf;
    --ds-text-muted:     #7d8694;
    --ds-text-faint:     #565d68;
    --ds-text-disabled:  #565d68;

    --ds-border-primary:   #414a56;
    --ds-border-secondary: #545d6f;
    --ds-border-tertiary:  #545d6f;

    --ds-accent-positive:       #22e3a8;
    --ds-accent-positive-hover: #3fecb8;
    --ds-accent-negative:       #ff5a82;
    --ds-accent-negative-hover: #ff7898;
    --ds-accent-warning:        #f5c14b;
    --ds-accent-info:           #22d3ee;
    --ds-accent-info-hover:     #4ae0f2;
    --ds-accent-highlight:      #22d3ee;
    --ds-accent-purple:         #a78bfa;

    --ds-action-buy-bg:    #22e3a8;
    --ds-action-buy-fg:    #07251b;
    --ds-action-sell-bg:   #ff5a82;
    --ds-action-sell-fg:   #2a0810;

    --ds-state-focus-ring:    #22d3ee;
    --ds-state-focus-ring-bg: rgba(34,211,238,0.12);
    --ds-state-disabled-bg:   #3b434e;
    --ds-state-disabled-fg:   #565d68;
    --ds-state-hover-overlay: rgba(255,255,255,0.05);
    --ds-state-selection:     rgba(34,211,238,0.22);

    --ds-overlay-positive-soft:  rgba(34,227,168,0.12);
    --ds-overlay-positive-ring:  rgba(34,227,168,0.40);
    --ds-overlay-negative-soft:  rgba(255,90,130,0.12);
    --ds-overlay-negative-ring:  rgba(255,90,130,0.40);
    --ds-overlay-warning-soft:   rgba(245,193,75,0.13);
    --ds-overlay-warning-ring:   rgba(245,193,75,0.40);
    --ds-overlay-info-soft:      rgba(34,211,238,0.12);
    --ds-overlay-info-ring:      rgba(34,211,238,0.45);
    --ds-overlay-neutral-soft:   rgba(170,179,191,0.10);
    --ds-overlay-neutral-ring:   rgba(170,179,191,0.25);

    --ds-scrollbar:  #545d6f;

    --ds-elevation-card:    0 1px 0 rgba(255,255,255,0.04) inset, 0 2px 6px rgba(0,0,0,0.5);
    --ds-elevation-overlay: 0 1px 0 rgba(255,255,255,0.05) inset, 0 8px 24px rgba(0,0,0,0.55), 0 2px 6px rgba(0,0,0,0.4);
    --ds-elevation-glow:    0 0 0 2px rgba(34,211,238,0.40), 0 0 24px rgba(34,211,238,0.16);

    --ds-trade-flat:           #7d8694;
    --ds-trade-positive-strip: rgba(34,227,168,0.12);
    --ds-trade-negative-strip: rgba(255,90,130,0.12);
    --ds-trade-bid-fill:       rgba(34,227,168,0.16);
    --ds-trade-ask-fill:       rgba(255,90,130,0.16);

    --ds-chart-1: #22d3ee;
    --ds-chart-2: #22e3a8;
    --ds-chart-3: #f5c14b;
    --ds-chart-4: #a78bfa;
    --ds-chart-5: #ff5a82;

    /* ── shadcn-compat HSL channel aliases (Stockflux SLATE BLUE) ── */
    --background:             214 18% 15%;
    --foreground:             213 31% 94%;
    --card:                   214 14% 19%;
    --card-foreground:        213 31% 94%;
    --popover:                214 14% 19%;
    --popover-foreground:     213 31% 94%;
    --primary:                188 86% 53%;
    --primary-foreground:     193 76% 10%;
    --secondary:              214 14% 23%;
    --secondary-foreground:   214 14% 71%;
    --muted:                  214 14% 23%;
    --muted-foreground:       217 10% 54%;
    --accent:                 188 86% 53%;
    --accent-foreground:      193 76% 10%;
    --destructive:            345 100% 68%;
    --destructive-foreground: 346 68% 10%;
    --success:                162 78% 51%;
    --success-foreground:     160 68% 9%;
    --warning:                42 89% 63%;
    --warning-foreground:     213 31% 94%;
    --info:                   188 86% 53%;
    --info-foreground:        193 76% 10%;
    --border:                 214 14% 30%;
    --input:                  214 14% 30%;
    --ring:                   188 86% 53%;

    --sidebar-background:              214 18% 15%;
    --sidebar-foreground:              213 31% 94%;
    --sidebar-primary:                 188 86% 53%;
    --sidebar-primary-foreground:      193 76% 10%;
    --sidebar-accent:                  214 14% 23%;
    --sidebar-accent-foreground:       213 31% 94%;
    --sidebar-border:                  214 14% 30%;
    --sidebar-ring:                    188 86% 53%;

    --chart-1: 188 86% 53%;
    --chart-2: 162 78% 51%;
    --chart-3: 42 89% 63%;
    --chart-4: 255 92% 76%;
    --chart-5: 345 100% 68%;

    --surface-50:  214 14% 19%;
    --surface-100: 214 14% 23%;
    --surface-200: 215 14% 27%;
    --surface-300: 220 14% 38%;
    --surface-400: 220 14% 38%;
    --surface-500: 214 14% 30%;
    --surface-600: 217 9% 37%;
    --surface-700: 217 10% 54%;
    --surface-800: 214 14% 71%;
    --surface-900: 213 31% 94%;
    --surface-950: 214 18% 15%;

    /* ── PrimeNG var bridge (for tailwindcss-primeui) ── */
    --p-primary-color:        #22d3ee;
    --p-primary-color-text:   #06232b;
    --p-surface-50:           #2a3038;
    --p-surface-100:          #323942;
    --p-surface-200:          #3b434e;
    --p-surface-900:          #ecf0f5;
    --p-surface-950:          #20262e;
    --p-text-color:           #ecf0f5;
    --p-text-muted-color:     #7d8694;
    --p-content-background:   #2a3038;
    --p-content-border-color: #414a56;
    --p-content-color:        #ecf0f5;

    /* ── Typography vars ── */
    --ds-font-sans:  'Inter', system-ui, -apple-system, 'Segoe UI', 'Geist', sans-serif;
    --ds-font-mono:  'JetBrains Mono', 'IBM Plex Mono', ui-monospace, 'SF Mono', monospace;
    --ds-font-serif: 'Geist', Georgia, serif;
    --ds-font-size-2xs: 10px;
    --ds-font-size-xs:  11px;
    --ds-font-size-sm:  12px;
    --ds-font-size-md:  13px;
    --ds-font-size-lg:  14px;
    --ds-font-size-xl:  16px;
    --ds-font-size-2xl: 20px;
    --ds-font-size-3xl: 28px;
    --ds-font-size-4xl: 40px;
    --ds-font-size-5xl: 56px;
    --ds-font-variant-tabular: tabular-nums;
    --ds-radius-sm:   2px;
    --ds-radius-md:   2px;
    --ds-radius-lg:   2px;
    --ds-radius-xl:   2px;
    --ds-radius-full: 9999px;
    --radius:         2px;

    /* ── Motion vars (Stockflux tokens.css) ── */
    --ds-tx-instant: 80ms cubic-bezier(0.4,0,0.6,1);
    --ds-tx-fast:    140ms cubic-bezier(0.4,0,0.2,1);
    --ds-tx-normal:  220ms cubic-bezier(0.4,0,0.2,1);
    --ds-tx-slow:    420ms cubic-bezier(0.4,0,0.2,1);
    --ds-tx-tick:    900ms cubic-bezier(0.25,0.1,0.25,1);
    --sf-t-instant:  80ms cubic-bezier(0.4,0,0.6,1);
    --sf-t-fast:     140ms cubic-bezier(0.4,0,0.2,1);
    --sf-t-normal:   220ms cubic-bezier(0.4,0,0.2,1);
    --sf-t-slow:     420ms cubic-bezier(0.4,0,0.2,1);
    --sf-t-tick:     900ms cubic-bezier(0.25,0.1,0.25,1);

    /* ── Control density tiers (compact controls — see tokens/controls.ts) ── */
    --ds-control-xs-height:       24px;
    --ds-control-xs-padding-x:    8px;
    --ds-control-xs-gap:          4px;
    --ds-control-xs-font-size:    12px;
    --ds-control-xs-icon-size:    12px;
    --ds-control-xs-radius:       2px;
    --ds-control-sm-height:       26px;
    --ds-control-sm-padding-x:    10px;
    --ds-control-sm-gap:          6px;
    --ds-control-sm-font-size:    12px;
    --ds-control-sm-icon-size:    14px;
    --ds-control-sm-radius:       2px;
    --ds-control-md-height:       28px;
    --ds-control-md-padding-x:    12px;
    --ds-control-md-gap:          6px;
    --ds-control-md-font-size:    13px;
    --ds-control-md-icon-size:    14px;
    --ds-control-md-radius:       2px;
    --ds-control-lg-height:       30px;
    --ds-control-lg-padding-x:    12px;
    --ds-control-lg-gap:          8px;
    --ds-control-lg-font-size:    13px;
    --ds-control-lg-icon-size:    16px;
    --ds-control-lg-radius:       2px;

    /* ── Legacy bn-* / fi-* aliases (apps + cell renderers) ── */
    --bn-bg:        #20262e;
    --bn-bg-sunken: #2a3038;
    --bn-bg1:       #2a3038;
    --bn-bg2:       #323942;
    --bn-bg3:       #3b434e;
    --bn-bg4:       #545d6f;
    --bn-t0:        #ecf0f5;
    --bn-t1:        #aab3bf;
