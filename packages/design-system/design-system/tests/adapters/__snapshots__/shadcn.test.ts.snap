    --bn-bg2:       #e9ecf0;
    --bn-bg3:       #dde1e7;
    --bn-bg4:       #c8cdd5;
    --bn-t0:        #18222f;
    --bn-t1:        #2f3a4a;
    --bn-t2:        #525d6c;
    --bn-t3:        #7a8392;
    --bn-t4:        #abb1bb;
    --bn-border:    #d4d8de;
    --bn-border2:   #b6bbc4;
    --bn-border3:   #8e94a0;
    --bn-green:     #0f766e;
    --bn-green2:    #0a5d56;
    --bn-red:       #be1f43;
    --bn-red2:      #9e1838;
    --bn-amber:     #b27607;
    --bn-blue:      #2563eb;
    --bn-blue2:     #1d4ed8;
    --bn-info:      #0e7490;
