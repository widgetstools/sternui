    --ds-border-primary:   #2b2820;
    --ds-border-secondary: #3b372d;
    --ds-border-tertiary:  #534e3f;

    --ds-accent-positive:       #2dd4bf;
    --ds-accent-positive-hover: #5eead4;
    --ds-accent-negative:       #f25668;
    --ds-accent-negative-hover: #ff7484;
    --ds-accent-warning:        #f5c14b;
    --ds-accent-info:           #38bdf8;
