    --sf-border-3:  #545d6f;
    --sf-teal:      #22d3ee;
    --sf-teal-hi:   #4ae0f2;
    --sf-teal-lo:   #4ae0f2;
    --sf-teal-soft: rgba(34,211,238,0.12);
    --sf-teal-ring: rgba(34,211,238,0.45);
    --sf-up:        #22e3a8;
    --sf-up-hi:     #3fecb8;
    --sf-up-soft:   rgba(34,227,168,0.12);
    --sf-up-strip:  rgba(34,227,168,0.12);
    --sf-down:      #ff5a82;
    --sf-down-hi:   #ff7898;
    --sf-down-soft: rgba(255,90,130,0.12);
    --sf-down-strip:rgba(255,90,130,0.12);
    --sf-flat:      #7d8694;
    --sf-info:      #22d3ee;
    --sf-info-soft: rgba(34,211,238,0.12);
    --sf-warn:      #f5c14b;
    --sf-warn-soft: rgba(245,193,75,0.13);
    --sf-success:   #22e3a8;
    --sf-error:     #ff5a82;
    --sf-bid-fill:  rgba(34,227,168,0.16);
    --sf-ask-fill:  rgba(255,90,130,0.16);
    --sf-scrollbar: #545d6f;
  }

  [data-theme="light"]:not([data-variant="paper"]),
  [data-theme="light"][data-variant="clinical"] {
    /* ── FI Design System source tokens ── */
    --ds-primary:           #0891b2;
    --ds-primary-hover:     #0e7490;
    --ds-primary-display:   #0891b2;
    --ds-primary-highlight: #0e7490;
    --ds-primary-pressed:   #0e7490;
    --ds-primary-foreground:#ffffff;
    --ds-primary-soft:      rgba(8,145,178,0.10);
    --ds-primary-ring:      rgba(8,145,178,0.32);

    --ds-surface-ground:     #f4f6f8;
    --ds-surface-sunken:     #ffffff;
    --ds-surface-primary:    #ffffff;
    --ds-surface-secondary:  #eef1f4;
    --ds-surface-tertiary:   #e3e8ee;
    --ds-surface-quaternary: #c2cad4;

    --ds-text-primary:   #0f172a;
    --ds-text-secondary: #334155;
    --ds-text-muted:     #64748b;
    --ds-text-faint:     #94a3b8;
    --ds-text-disabled:  #94a3b8;

    --ds-border-primary:   #dce2e9;
    --ds-border-secondary: #c2cad4;
    --ds-border-tertiary:  #c2cad4;

    --ds-accent-positive:       #0d9488;
    --ds-accent-positive-hover: #0b7a70;
    --ds-accent-negative:       #e11d48;
    --ds-accent-negative-hover: #be123c;
    --ds-accent-warning:        #c2410c;
    --ds-accent-info:           #0891b2;
    --ds-accent-info-hover:     #0e7490;
    --ds-accent-highlight:      #0891b2;
    --ds-accent-purple:         #7c3aed;

    --ds-action-buy-bg:    #0d9488;
    --ds-action-buy-fg:    #ffffff;
    --ds-action-sell-bg:   #e11d48;
    --ds-action-sell-fg:   #ffffff;

    --ds-state-focus-ring:    #0891b2;
    --ds-state-focus-ring-bg: rgba(8,145,178,0.10);
    --ds-state-disabled-bg:   #eef1f4;
    --ds-state-disabled-fg:   #94a3b8;
    --ds-state-hover-overlay: rgba(15,23,42,0.04);
    --ds-state-selection:     rgba(8,145,178,0.16);

    --ds-overlay-positive-soft:  rgba(13,148,136,0.10);
    --ds-overlay-positive-ring:  rgba(13,148,136,0.32);
    --ds-overlay-negative-soft:  rgba(225,29,72,0.09);
    --ds-overlay-negative-ring:  rgba(225,29,72,0.30);
    --ds-overlay-warning-soft:   rgba(194,65,12,0.10);
    --ds-overlay-warning-ring:   rgba(194,65,12,0.32);
    --ds-overlay-info-soft:      rgba(8,145,178,0.09);
    --ds-overlay-info-ring:      rgba(8,145,178,0.30);
    --ds-overlay-neutral-soft:   rgba(51,65,85,0.07);
    --ds-overlay-neutral-ring:   rgba(51,65,85,0.20);

    --ds-scrollbar:  #c2cad4;

    --ds-elevation-card:    0 1px 2px rgba(15,23,42,0.06);
    --ds-elevation-overlay: 0 1px 2px rgba(15,23,42,0.08), 0 8px 22px rgba(15,23,42,0.10);
    --ds-elevation-glow:    0 0 0 3px rgba(8,145,178,0.18);

    --ds-trade-flat:           #64748b;
    --ds-trade-positive-strip: rgba(13,148,136,0.10);
    --ds-trade-negative-strip: rgba(225,29,72,0.09);
    --ds-trade-bid-fill:       rgba(13,148,136,0.10);
    --ds-trade-ask-fill:       rgba(225,29,72,0.09);

    --ds-chart-1: #0891b2;
    --ds-chart-2: #0d9488;
    --ds-chart-3: #c2410c;
    --ds-chart-4: #7c3aed;
    --ds-chart-5: #e11d48;

    /* ── shadcn-compat HSL channel aliases (Stockflux SLATE BLUE) ── */
    --background:             210 22% 96%;
    --foreground:             222 47% 11%;
    --card:                   0 0% 100%;
    --card-foreground:        222 47% 11%;
    --popover:                0 0% 100%;
    --popover-foreground:     222 47% 11%;
    --primary:                192 91% 36%;
    --primary-foreground:     0 0% 100%;
    --secondary:              210 21% 95%;
